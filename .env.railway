# Application
APP_NAME="Warehouse AMTPM System"
APP_DISPLAY_NAME="Warehouse AMTPM System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://amtpm-warehouse.up.railway.app
APP_KEY=base64:XPrWYP/pJnEJlVGtA2qiuJg6XWSEpge+E+xpJguF3Uk=
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Maintenance
APP_MAINTENANCE_DRIVER=file

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration
# Railway MySQL service - copy these values from MySQL service Variables tab
DB_CONNECTION=mysql
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=acMynSNQeDskxQxUQoFlKuwrRidPSGEp

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache
CACHE_STORE=database

# Queue
QUEUE_CONNECTION=database

# Broadcast
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@amtpm-system.com"
MAIL_FROM_NAME="${APP_NAME}"

# Redis (opsional, jika Railway menyediakan)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# File Storage Configuration
# Options: local, s3, r2, railway-volumes
# For production, use cloud storage (s3 recommended)
FILESYSTEM_DISK=local

# AWS S3 Configuration (for production file storage)
# Get credentials from: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (alternative to S3, free tier available)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_REGION=auto
# R2_ENDPOINT=
# R2_PUBLIC_URL=

# Google OAuth (isi dengan credentials dari Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://amtpm-warehouse.up.railway.app/auth/google/callback

# Fonnte WhatsApp (opsional)
FONNTE_TOKEN=
FONNTE_BASE_URL=https://api.fonnte.com

# AMTPM System Configuration
AMTPM_DEFAULT_ROLE=operator

# Scanner Configuration
SCANNER_SCAN_WIDTH=320
SCANNER_SCAN_HEIGHT=240
SCANNER_SCAN_INTERVAL=120
SCANNER_CAMERA_WIDTH=640
SCANNER_CAMERA_HEIGHT=480
SCANNER_FACING_MODE=environment
SCANNER_WORKER_SCRIPT=/js/qr-scanner-worker.js

# Image Compression Settings
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_QUALITY=80
IMAGE_CONVERT_TO_WEBP=false
IMAGE_PROGRESSIVE_JPEG=true
IMAGE_OPTIMIZE_PNG=true

# Vite
VITE_APP_NAME="${APP_NAME}"

# Asset URL for HTTPS
ASSET_URL=https://amtpm-warehouse.up.railway.app
