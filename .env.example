APP_NAME="Warehouse AMTPM System"
APP_DISPLAY_NAME="Warehouse AMTPM System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Railway Deployment Variables
# On Railway, these will be automatically set:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-app.railway.app
# DB_CONNECTION=mysql
# DATABASE_URL=postgresql://user:pass@host:port/db
# or MYSQL_URL=mysql://user:pass@host:port/db

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production: gunakan MySQL / MariaDB stabil
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=warehouse_amtpm
# DB_USERNAME=root
# DB_PASSWORD=

# Railway Database Configuration
# Railway will automatically provide DATABASE_URL
# You can use it directly in your database config
# Example: mysql://user:password@host:port/database

MAINTENANCE_REMINDER_TIME="06:30"

# Fonnte WhatsApp — https://docs.fonnte.com/
FONNTE_TOKEN=
FONNTE_BASE_URL=https://api.fonnte.com

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Image Compression Settings
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_QUALITY=80
IMAGE_CONVERT_TO_WEBP=false
IMAGE_PROGRESSIVE_JPEG=true
IMAGE_OPTIMIZE_PNG=true

# AMTPM System Configuration
AMTPM_DEFAULT_ROLE=operator

# Scanner Configuration
SCANNER_SCAN_WIDTH=320
SCANNER_SCAN_HEIGHT=240
SCANNER_SCAN_INTERVAL=120
SCANNER_CAMERA_WIDTH=640
SCANNER_CAMERA_HEIGHT=480
SCANNER_FACING_MODE=environment
SCANNER_WORKER_SCRIPT=/js/qr-scanner-worker.js

VITE_APP_NAME="${APP_NAME}"
